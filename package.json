{
  "name": "openboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:core": "tsc -p tsconfig.core.json",
    "test:core": "npm run build:core && node --test tests/*.test.mjs",
    "validate:contracts": "node scripts/validate-contracts.mjs",
    "verify:core": "npm run validate:contracts && npm run test:core",
    "build": "npm run build:core",
    "start": "npm run build && node dist/index.js",
    "test": "npm run test:core"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@modelcontextprotocol/server": "2.0.0",
    "@observablehq/plot": "0.6.17",
    "ws": "^8.18.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/ws": "^8.5.14",
    "typescript": "5.8.3"
  }
}
